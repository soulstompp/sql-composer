# A set as one JSON document: its number, name, year and theme, and each version with its lines.
# One row, keyed by set_num. Every line of the parts listing is in the document once, so the
# document and the listing always agree. A set with no theme keeps its document, with a null theme.
WITH set_part_details AS (
    :compose(shared/set_part_details.sqlc)
),
versions AS (
    SELECT
        version,
        inventory_id,
        jsonb_agg(
            jsonb_build_object(
                'part_num', part_num,
                'color_id', color_id,
                'is_spare', is_spare,
                'quantity', quantity,
                'part_name', part_name,
                'color_name', color_name
            )
            ORDER BY part_num, color_id, is_spare
        ) AS lines
    FROM set_part_details
    GROUP BY version, inventory_id
)
SELECT
    s.set_num,
    jsonb_build_object(
        'set_num', s.set_num,
        'name', s.name,
        'year', s.year,
        'theme', t.name,
        'versions', (
            SELECT jsonb_agg(
                jsonb_build_object(
                    'version', v.version,
                    'inventory_id', v.inventory_id,
                    'lines', v.lines
                )
                ORDER BY v.version
            )
            FROM versions v
        )
    ) AS document
FROM lego_sets s
LEFT JOIN lego_themes t ON t.id = s.theme_id
WHERE s.set_num = :bind(set_num)
